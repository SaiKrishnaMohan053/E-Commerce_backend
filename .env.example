# Copy into .env only for local development; never commit real credentials.
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb+srv://username:password@cluster.example.mongodb.net/ecommerce_dev
JWT_SECRET=replace_with_a_secure_random_secret_of_at_least_32_characters
# Comma-separated, exact origins; no trailing routes or wildcards.
FRONTEND_URL=http://localhost:3000
# Configure ALL AWS settings together when S3 is used.
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=your_s3_bucket_name
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
# Configure both SMTP settings together if email sending is needed.
EMAIL_USER=your_email_address
EMAIL_PASS=your_email_app_password
ADMIN_EMAIL=your_admin_email
PERIOD_WEEKS=4
LEAD_TIME_DAYS=7
SAFETY_FACTOR=1
FAST_PERCENTILE=0.75
SLOW_PERCENTILE=0.25
